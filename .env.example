# Environment Configuration Example
# Copy to .env and adjust values as needed

# Development Configuration
VITE_DEV_HOST=localhost
VITE_DEV_PORT=1420
VITE_HMR_PORT=1421

# Network Configuration (testnet/mainnet)
VITE_DEFAULT_NETWORK=testnet
VITE_MIN_CREDIT_TRANSFER=100000
VITE_DEFAULT_IDENTITY_SEARCH_LIMIT=3

# API Endpoints
VITE_DASHSWAP_ENDPOINT=https://dashswap.xyz/v1
VITE_DAPI_WEB_API_ENDPOINT=https://dashqt.org/v1/dapi
VITE_PLATFORM_HTTP_API_MAINNET=https://platform-explorer.pshenmic.dev
VITE_PLATFORM_HTTP_API_TESTNET=https://testnet.platform-explorer.pshenmic.dev

# Security/Performance Settings
VITE_DEFAULT_QUERY_REGISTRY=false
VITE_DEFAULT_SECURITY_LEVEL=0
VITE_PRICE_UPDATE_INTERVAL_MS=30000
VITE_BALANCE_REFRESH_INTERVAL_MS=60000

# Feature Flags
VITE_ENABLE_PREMIUM_FEATURES=true
VITE_ENABLE_AUTO_UPDATE=true
VITE_ENABLE_ANALYTICS=false

# Logging Configuration
VITE_LOG_LEVEL=info
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_FILE_LOGS=false
