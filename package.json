{
  "name": "evonext-desktop",
  "description": "Free and Fearless Social — Connect with early-stage Founders and Creators — plus, the hottest collection of Mini Apps designed to streamline your workflow and simplify everyday tasks.",
  "version": "26.1.29",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm type:gen && vite",
    "build": "pnpm type:gen && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path=./src-tauri/Cargo.toml",
    "test:e2e": "pnpm tauri build && pnpm exec wdio run wdio.conf.ts",
    "type:gen": "(cd src-tauri && cargo run --bin export_types) && node -e \"const f='src/types/rust_generated.ts'; const fs=require('fs'); fs.writeFileSync(f, '//@ts-nocheck\\n' + fs.readFileSync(f))\"",
    "check": "pnpm type:gen && pnpm test:rust && vue-tsc --noEmit && pnpm test",
    "postinstall": "pnpm type:gen"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "3.0.0-dev.11",
    "@evonext/platform": "25.11.23",
    "@evonext/utils": "25.11.25",
    "@heroicons/vue": "2.2.0",
    "@scure/base": "2.0.0",
    "@tauri-apps/plugin-opener": "2.5.0",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-updater": "2.9.0",
    "bip39": "3.1.0",
    "crypto-js": "4.2.0",
    "dash-platform-sdk": "1.3.0-dev.12",
    "monaco-editor": "0.55.1",
    "pinia": "3.0.3",
    "pshenmic-dpp": "1.1.2-dev.4",
    "qrcode.vue": "3.6.0",
    "tauri-plugin-sentry-api": "0.5.0",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "25.0.3",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/browser": "4.0.16",
    "@vitest/ui": "4.0.16",
    "@vue/test-utils": "2.4.6",
    "appium": "3.1.2",
    "autoprefixer": "10.4.20",
    "happy-dom": "20.0.11",
    "jsdom": "27.3.0",
    "postcss-cli": "11.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "7.1.9",
    "vitest": "4.0.16",
    "vue-tsc": "3.1.0"
  }
}
